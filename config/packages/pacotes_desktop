# Pacotes do ambiente gráfico GNOME.
# Para trocar de desktop, substitua os pacotes abaixo pelos do novo ambiente.
# O Containerfile detecta automaticamente se o gnome-shell está nesta lista:
# com ele, instala o GNOME sem dependências fracas; sem ele, pula esse passo.
gnome-shell
glycin-thumbnailer
gnome-epub-thumbnailer
papers-thumbnailer
adw-gtk3-theme
libnma
ibus-typing-booster
ibus-gtk4
gnome-shell-extension-appindicator
nautilus
ptyxis
gnome-backgrounds
f45-backgrounds-gnome
gnome-initial-setup

# Sons do GNOME (ex.: screenshot, alertas do terminal).
# Sem estes backends, alguns efeitos sonoros do GNOME ficam mudos.
libcanberra-backend-pulse
libcanberra-backend-gstreamer
libcanberra-backend-alsa

# Plymouth deixa o boot mais bonito. (Esse pode permanecer em todos os ambientes gráficos)
plymouth
plymouth-core-libs
plymouth-graphics-libs
plymouth-plugin-label
plymouth-plugin-two-step
plymouth-scripts
plymouth-system-theme
plymouth-theme-spinner
